# Copy to .env.local and fill in from Firebase console > Project settings > Your apps.
# A Firebase web config identifies the project; it is not a secret. The security
# rules in firestore.rules are what protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
